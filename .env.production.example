# Production environment for Docker Compose
# Copy to .env.production and set values. Do not commit .env.production.

# Required: MongoDB connection (use service name "mongo" when running in Docker)
MONGO_URI=mongodb://mongo:27017/gen_cl

# Optional: MongoDB auth (uncomment and set; then use in MONGO_URI)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
# MONGO_URI=mongodb://admin:change-me-strong-password@mongo:27017/gen_cl?authSource=admin

# Required: JWT secret (min 32 characters)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Required: Public URL of the app (no trailing slash) — used for CORS and links
CORS_ORIGIN=https://your-domain.com

# Optional: Host port for frontend (default 80)
# HTTP_PORT=80
